# AnyLog init type
# -> prod: run AnyLog instance
# -> bash: run shell interface with AnyLog installed and params set
INIT_TYPE=prod

# AnyLog or EdgeLake image
IMAGE=docker.io/anylogco/anylog-network

# Service version (semantic versioning format: e.g., "1", "1.0", "1.25.03")
SERVICE_VERSION=1.0.0

# License key (required for publish, register, and start operations)
LICENSE_KEY=<placeholder>

# IMAGE=docker.io/anylogco/anylog-network


# params for Remote-CLI
CONN_IP=0.0.0.0
CLI_PORT=31800
