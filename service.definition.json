{
  "org": "$HZN_ORG_ID",
  "label": "$SERVICE_NAME for $ARCH",
  "description": "A service to deploy EdgeLake with Open Horizon",
  "documentation": "https://edgelake.github.io/",
  "url": "$SERVICE_NAME",
  "version": "$SERVICE_VERSION",
  "arch": "$ARCH",
  "public": true,
  "sharable": "singleton",
  "requiredServices": [],
  "userInput": [
    {
      "name": "NODE_TYPE",
      "label": "AnyLog node type (generic, master, operator, query, publisher)",
      "type": "string",
      "defaultValue": "generic"
    },
    {
      "name": "NODE_NAME",
      "label": "Name of the AnyLog instance",
      "type": "string",
      "defaultValue": "anylog-node"
    },
    {
      "name": "COMPANY_NAME",
      "label": "Owner of the AnyLog instance",
      "type": "string",
      "defaultValue": "New Company"
    },
    {
      "name": "ANYLOG_SERVER_PORT",
      "label": "TCP port for node-to-node communication",
      "type": "int",
      "defaultValue": "32548"
    },
    {
      "name": "ANYLOG_REST_PORT",
      "label": "REST API port",
      "type": "int",
      "defaultValue": "32549"
    }
  ],
  "deployment": {
    "services": {
      "$SERVICE_NAME": {
        "image": "$DOCKER_IMAGE_BASE:$DOCKER_IMAGE_VERSION",
        "user": "10001:10001",
        "network": "host",
        "privileged": true,
        "binds": [
          "${NODE_NAME}-anylog:/app/AnyLog-Network/anylog",
          "${NODE_NAME}-blockchain:/app/AnyLog-Network/blockchain",
          "${NODE_NAME}-data:/app/AnyLog-Network/data"
        ]
      }
    }
  }
}
